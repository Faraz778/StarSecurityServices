<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@ViewData["Title"] - Employee Portal</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
  <style>
    :root { --primary:#84C729; --dark:#091E3E; }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Heebo',sans-serif; background:#f0f4f8; }

    /* TOPBAR */
    .emp-topbar {
      background:var(--dark);
      padding:14px 28px;
      display:flex; align-items:center; justify-content:space-between;
      position:sticky; top:0; z-index:99;
      box-shadow:0 2px 10px rgba(0,0,0,.2);
    }
    .emp-brand {
      display:flex; align-items:center; gap:10px;
      font-size:1.1rem; font-weight:800; color:#fff;
    }
    .brand-hex {
      width:32px; height:32px; background:var(--primary);
      clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
      display:flex; align-items:center; justify-content:center;
    }
    .brand-hex i { color:#fff; font-size:.75rem; }
    .emp-nav { display:flex; align-items:center; gap:8px; }
    .emp-nav a {
      font-size:.8rem; font-weight:600; color:rgba(255,255,255,.65);
      text-decoration:none; padding:7px 14px; border-radius:3px;
      transition:background .2s, color .2s;
      display:flex; align-items:center; gap:6px;
    }
    .emp-nav a:hover { background:rgba(255,255,255,.08); color:#fff; }
    .emp-nav .btn-logout-emp {
      background:rgba(220,53,69,.15);
      color:#ff6b6b;
    }
    .emp-nav .btn-logout-emp:hover { background:#dc3545; color:#fff; }

    /* CONTENT */
    .emp-content { padding:30px; max-width:1000px; margin:0 auto; }

    /* WELCOME BAR */
    .welcome-bar {
      background:linear-gradient(135deg, var(--dark) 0%, #1a3a6e 100%);
      padding:22px 28px; border-radius:4px;
      display:flex; align-items:center; justify-content:space-between;
      margin-bottom:28px;
      border-left:4px solid var(--primary);
    }
    .welcome-text { font-size:1.1rem; font-weight:700; color:#fff; }
    .welcome-sub { font-size:.8rem; color:rgba(255,255,255,.55); margin-top:3px; }
    .welcome-date { font-size:.8rem; color:rgba(255,255,255,.5); text-align:right; }

    /* PROFILE */
    .profile-header {
      background:#fff; padding:28px;
      border-radius:4px; display:flex;
      align-items:center; gap:20px;
      box-shadow:0 2px 12px rgba(0,0,0,.05);
      border-left:4px solid var(--primary);
    }
    .profile-avatar {
      width:70px; height:70px; background:rgba(132,199,41,.15);
      border:3px solid var(--primary); border-radius:50%;
      display:flex; align-items:center; justify-content:center;
      flex-shrink:0;
    }
    .profile-avatar i { color:var(--primary); font-size:1.8rem; }
    .profile-name { font-size:1.4rem; font-weight:800; color:var(--dark); }
    .profile-code { font-size:.82rem; color:#666; margin-top:4px; }
    .profile-dept { font-size:.82rem; color:#666; margin-top:2px; }

    /* INFO CARD */
    .info-card {
      background:#fff; border-radius:4px;
      box-shadow:0 2px 12px rgba(0,0,0,.05);
      overflow:hidden; height:100%;
    }
    .info-card-title {
      background:var(--dark); color:#fff;
      padding:14px 20px; font-size:.88rem;
      font-weight:700; display:flex; align-items:center; gap:8px;
    }
    .info-card-title i { color:var(--primary); }
    .info-row {
      display:flex; padding:13px 20px;
      border-bottom:1px solid #f0f4f8;
      align-items:center;
    }
    .info-row:last-child { border-bottom:none; }
    .info-label {
      font-size:.76rem; font-weight:600; letter-spacing:.5px;
      text-transform:uppercase; color:#888;
      width:140px; flex-shrink:0;
    }
    .info-val { font-size:.88rem; color:var(--dark); }
    .grade-badge {
      background:rgba(132,199,41,.1);
      color:var(--primary); font-size:.76rem;
      font-weight:700; padding:4px 12px;
      border-radius:20px; letter-spacing:.5px;
    }

    /* ALERT */
    .alert-box {
      background:#fff3cd; border:1px solid #ffc107;
      color:#856404; padding:16px 20px;
      border-radius:4px; font-size:.88rem;
      display:flex; align-items:center; gap:10px;
    }

    /* EMPLOYEE CARDS */
.emp-card {
    background:#fff; border-radius:4px;
    box-shadow:0 2px 12px rgba(0,0,0,.05);
    overflow:hidden;
    transition:transform .3s, box-shadow .3s;
}
.emp-card:hover {
    transform:translateY(-4px);
    box-shadow:0 8px 24px rgba(132,199,41,.12);
}
.emp-card-header {
    background:var(--dark); padding:18px 20px;
    display:flex; align-items:center; gap:14px;
    border-left:4px solid var(--primary);
}
.emp-avatar {
    width:44px; height:44px;
    background:rgba(132,199,41,.2);
    border:2px solid var(--primary);
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
}
.emp-avatar i { color:var(--primary); font-size:1.1rem; }
.emp-card-name { font-size:.95rem; font-weight:700; color:#fff; }
.emp-card-code { font-size:.75rem; color:var(--primary); margin-top:2px; }
.emp-card-body { padding:16px 20px; }
.emp-info-row {
    display:flex; align-items:center; gap:10px;
    font-size:.82rem; color:#555;
    padding:6px 0; border-bottom:1px solid #f0f4f8;
}
.emp-info-row:last-child { border-bottom:none; }
.emp-info-row i { color:var(--primary); width:14px; font-size:.8rem; }
.emp-card-footer {
    padding:14px 20px;
    border-top:1px solid #f0f4f8;
    background:#fafafa;
}
.emp-detail-btn {
    font-size:.78rem; font-weight:700; letter-spacing:.5px;
    text-transform:uppercase; color:var(--primary);
    text-decoration:none; display:inline-flex;
    align-items:center; gap:6px;
    transition:gap .2s;
}
.emp-detail-btn:hover { gap:10px; color:var(--primary); }

/* BACK BUTTON */
.btn-back-emp {
    font-size:.8rem; font-weight:600;
    background:#f0f4f8; color:var(--dark);
    padding:8px 18px; border-radius:3px;
    text-decoration:none; display:inline-flex;
    align-items:center; gap:6px;
    transition:background .2s;
}
.btn-back-emp:hover { background:#e2e8f0; color:var(--dark); }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <div class="emp-topbar">
    <div class="emp-brand">
      <div class="brand-hex"><i class="fas fa-shield-alt"></i></div>
      Star Security — Employee Portal
    </div>
    <div class="emp-nav">
      <a asp-controller="Employee" asp-action="Profile">
        <i class="fas fa-user"></i> My Profile
      </a>
      <a asp-controller="Employee" asp-action="EmployeeList">
    <i class="fas fa-users"></i> All Employees
</a>
      <a asp-controller="Home" asp-action="Index" target="_blank">
        <i class="fas fa-globe"></i> Website
      </a>

      <a asp-controller="Account" asp-action="Logout" class="btn-logout-emp">
        <i class="fas fa-sign-out-alt"></i> Logout
      </a>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="emp-content">

    <!-- WELCOME BAR -->
    <div class="welcome-bar">
      <div>
        <div class="welcome-text">
          Welcome, @Context.Session.GetString("Username")!
        </div>
        <div class="welcome-sub">Employee Portal — Star Security Services</div>
      </div>
      <div class="welcome-date">
        <i class="fas fa-calendar me-1" style="color:var(--primary)"></i>
        @DateTime.Now.ToString("dddd, dd MMM yyyy")
      </div>
    </div>

    @RenderBody()

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>