<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Star Security Services</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ===== TOP BAR ===== -->
    <div class="topbar">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="tb-item"><i class="fas fa-map-marker-alt"></i>M.A. Jinnah Road, Karachi</span>
                <span class="tb-item"><i class="fas fa-envelope"></i>info@starsecurity.pk</span>
                <span class="tb-item d-none d-md-inline-flex"><i class="fas fa-phone"></i>+92-21-111-782-782</span>
                <span class="tb-item d-none d-lg-inline-flex"><i class="fas fa-clock"></i>Mon–Sat: 9AM–6PM</span>
            </div>
            <div class="tb-social">
                <a href="#"><i class="fab fa-facebook-f"></i></a>
                <a href="#"><i class="fab fa-twitter"></i></a>
                <a href="#"><i class="fab fa-linkedin-in"></i></a>
                <a href="#"><i class="fab fa-whatsapp"></i></a>
            </div>
        </div>
    </div>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <div class="brand-hex"><i class="fas fa-shield-alt"></i></div>
                <div>Star Security<span class="brand-sub">Services & Solutions</span></div>
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navmenu">
                <i class="fas fa-bars" style="color:var(--primary)"></i>
            </button>
            <div class="collapse navbar-collapse" id="navmenu">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Services">Service</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Network">Network</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Pages</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Careers">Careers</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Testimonials">Testimonials</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn-nav-green nav-link" asp-controller="Account" asp-action="Login">
                            <i class="fas fa-lock me-1"></i>Login
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- ===== PAGE CONTENT ===== -->
    <main>
        @RenderBody()
    </main>

    <!-- ===== FOOTER ===== -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand">
                        <div class="brand-hex"><i class="fas fa-shield-alt"></i></div>Star Security
                    </div>
                    <p class="footer-desc">Pakistan's trusted Total Security Solutions Provider since 2000. ISO 9001:2000 certified — 2800+ personnel — 250+ corporate clients.</p>
                    <div class="f-socials">
                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                        <a href="#"><i class="fab fa-twitter"></i></a>
                        <a href="#"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6">
                    <div class="footer-heading">Services</div>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Services"><i class="fas fa-angle-right"></i>Manned Guarding</a></li>
                        <li><a asp-controller="Home" asp-action="Services"><i class="fas fa-angle-right"></i>Cash Services</a></li>
                        <li><a asp-controller="Home" asp-action="Services"><i class="fas fa-angle-right"></i>Electronic Systems</a></li>
                        <li><a asp-controller="Home" asp-action="Services"><i class="fas fa-angle-right"></i>Recruitment</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6">
                    <div class="footer-heading">Quick Links</div>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="About"><i class="fas fa-angle-right"></i>About Us</a></li>
                        <li><a asp-controller="Home" asp-action="Network"><i class="fas fa-angle-right"></i>Our Network</a></li>
                        <li><a asp-controller="Home" asp-action="Careers"><i class="fas fa-angle-right"></i>Careers</a></li>
                        <li>
                            <a asp-controller="Home" asp-action="SiteMap">
                                <i class="fas fa-angle-right"></i>Site Map
                            </a>
                        </li>
                        <li><a asp-controller="Home" asp-action="Contact"><i class="fas fa-angle-right"></i>Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6">
                    <div class="footer-heading">Newsletter</div>
                    <p class="footer-desc mb-3">Subscribe for security updates and company announcements.</p>
                    <div class="newsletter-wrap">
                        <input class="newsletter-input" type="email" placeholder="Your email address" />
                        <button class="newsletter-btn"><i class="fas fa-paper-plane"></i></button>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <div class="footer-copy">&copy; @DateTime.Now.Year Star Security Services. All Rights Reserved.</div>
                <div class="footer-copy">Developed by <span style="color:var(--primary)">Faraz</span></div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>