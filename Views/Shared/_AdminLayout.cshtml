<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>@ViewData["Title"] - Admin Panel</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet"/>
  <style>
    :root { --primary:#84C729; --dark:#091E3E; --sidebar-width:250px; }
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Heebo',sans-serif; background:#f0f4f8; }

    /* SIDEBAR */
    .sidebar {
      width:var(--sidebar-width); background:var(--dark);
      min-height:100vh; position:fixed; top:0; left:0; z-index:100;
      display:flex; flex-direction:column;
    }
    .sidebar-brand {
      padding:22px 20px; border-bottom:1px solid rgba(255,255,255,.07);
      display:flex; align-items:center; gap:10px;
    }
    .brand-hex {
      width:34px; height:34px; background:var(--primary);
      clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
      display:flex; align-items:center; justify-content:center; flex-shrink:0;
    }
    .brand-hex i { color:#fff; font-size:.8rem; }
    .brand-name { font-size:1rem; font-weight:800; color:#fff; }
    .brand-role { font-size:.6rem; letter-spacing:2px; text-transform:uppercase; color:var(--primary); }

    /* NAV */
    .sidebar-nav { padding:16px 0; flex:1; }
    .nav-section {
      font-size:.62rem; font-weight:700; letter-spacing:3px;
      text-transform:uppercase; color:rgba(255,255,255,.3);
      padding:14px 20px 6px;
    }
    .sidebar-nav a {
      display:flex; align-items:center; gap:12px;
      padding:11px 20px; color:rgba(255,255,255,.6);
      text-decoration:none; font-size:.84rem; font-weight:500;
      border-left:3px solid transparent;
      transition:all .2s;
    }
    .sidebar-nav a:hover,
    .sidebar-nav a.active {
      color:#fff; background:rgba(132,199,41,.1);
      border-left-color:var(--primary);
    }
    .sidebar-nav a i { width:18px; color:var(--primary); font-size:.9rem; }

    /* SIDEBAR FOOTER */
    .sidebar-footer {
      padding:16px 20px; border-top:1px solid rgba(255,255,255,.07);
    }
    .admin-info { display:flex; align-items:center; gap:10px; margin-bottom:12px; }
    .admin-avatar {
      width:36px; height:36px; background:var(--primary);
      border-radius:50%; display:flex; align-items:center; justify-content:center;
      color:#fff; font-size:.85rem; flex-shrink:0;
    }
    .admin-name { font-size:.85rem; font-weight:700; color:#fff; }
    .admin-role { font-size:.7rem; color:rgba(255,255,255,.4); }
    .btn-logout {
      display:flex; align-items:center; gap:8px;
      background:rgba(255,255,255,.06); color:rgba(255,255,255,.6);
      padding:9px 14px; border-radius:3px; text-decoration:none;
      font-size:.8rem; transition:background .2s, color .2s; width:100%;
    }
    .btn-logout:hover { background:#dc3545; color:#fff; }

    /* MAIN CONTENT */
    .main-content {
      margin-left:var(--sidebar-width);
      min-height:100vh;
    }

    /* TOP BAR */
    .topbar-admin {
      background:#fff; padding:14px 28px;
      border-bottom:1px solid #e2e8f0;
      display:flex; align-items:center; justify-content:space-between;
      position:sticky; top:0; z-index:99;
      box-shadow:0 2px 8px rgba(0,0,0,.05);
    }
    .page-title { font-size:1.1rem; font-weight:700; color:var(--dark); }
    .breadcrumb-admin { font-size:.78rem; color:#888; margin-top:2px; }
    .breadcrumb-admin span { color:var(--primary); }

    /* CONTENT AREA */
    .content-area { padding:28px; }

    /* STAT CARDS */
    .stat-card {
      background:#fff; padding:24px 22px;
      border-radius:4px; border-left:4px solid var(--primary);
      box-shadow:0 2px 12px rgba(0,0,0,.05);
      display:flex; align-items:center; gap:18px;
    }
    .stat-icon {
      width:52px; height:52px; background:rgba(132,199,41,.1);
      display:flex; align-items:center; justify-content:center;
      border-radius:4px; flex-shrink:0;
    }
    .stat-icon i { color:var(--primary); font-size:1.3rem; }
    .stat-num { font-size:1.8rem; font-weight:800; color:var(--dark); line-height:1; }
    .stat-lbl { font-size:.78rem; color:#888; margin-top:3px; }

    /* TABLE */
    .admin-table { background:#fff; border-radius:4px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,.05); }
    .admin-table .table { margin:0; }
    .admin-table .table thead th {
      background:var(--dark); color:#fff; font-size:.78rem;
      font-weight:600; letter-spacing:.5px; text-transform:uppercase;
      padding:14px 16px; border:none;
    }
    .admin-table .table tbody td { padding:13px 16px; font-size:.86rem; color:#444; vertical-align:middle; border-color:#f0f4f8; }
    .admin-table .table tbody tr:hover { background:#f8fff0; }

    /* FORM CARD */
    .form-card { background:#fff; padding:32px; border-radius:4px; box-shadow:0 2px 12px rgba(0,0,0,.05); }
    .form-card .form-label { font-size:.76rem; font-weight:600; letter-spacing:.5px; text-transform:uppercase; color:#666; }
    .form-card .form-control, .form-card .form-select {
      border:1.5px solid #e2e8f0; border-radius:3px;
      padding:10px 14px; font-size:.88rem; font-family:'Heebo',sans-serif;
    }
    .form-card .form-control:focus, .form-card .form-select:focus {
      border-color:var(--primary); box-shadow:none;
    }

    /* BUTTONS */
    .btn-primary-admin {
      background:var(--primary); color:#fff; border:none;
      padding:10px 24px; font-size:.82rem; font-weight:700;
      letter-spacing:.5px; border-radius:3px; cursor:pointer;
      transition:background .2s; font-family:'Heebo',sans-serif;
    }
    .btn-primary-admin:hover { background:#70ad1f; color:#fff; }
    .btn-edit { background:#0d6efd; color:#fff; border:none; padding:6px 14px; font-size:.76rem; border-radius:3px; text-decoration:none; transition:background .2s; }
    .btn-edit:hover { background:#0b5ed7; color:#fff; }
    .btn-delete { background:#dc3545; color:#fff; border:none; padding:6px 14px; font-size:.76rem; border-radius:3px; text-decoration:none; transition:background .2s; cursor:pointer; }
    .btn-delete:hover { background:#b02a37; color:#fff; }
    .btn-back { background:#6c757d; color:#fff; border:none; padding:9px 20px; font-size:.82rem; border-radius:3px; text-decoration:none; }
    .btn-back:hover { background:#5a6268; color:#fff; }

    /* BADGE */
    .badge-active { background:#d4edda; color:#155724; font-size:.72rem; padding:4px 10px; border-radius:20px; font-weight:600; }
    .badge-inactive { background:#f8d7da; color:#721c24; font-size:.72rem; padding:4px 10px; border-radius:20px; font-weight:600; }
  </style>
</head>
<body>

  <!-- SIDEBAR -->
  <div class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-hex"><i class="fas fa-shield-alt"></i></div>
      <div>
        <div class="brand-name">Star Security</div>
        <div class="brand-role">Admin Panel</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section">Main</div>
      <a asp-controller="Admin" asp-action="Dashboard">
        <i class="fas fa-gauge"></i>Dashboard
      </a>

      <div class="nav-section">Manage</div>
      <a asp-controller="Admin" asp-action="Employees">
        <i class="fas fa-users"></i>Employees
      </a>
      <a asp-controller="Admin" asp-action="Clients">
        <i class="fas fa-building"></i>Clients
      </a>
      <a asp-controller="Admin" asp-action="Vacancies">
        <i class="fas fa-briefcase"></i>Vacancies
      </a>
      <a asp-controller="Admin" asp-action="Services">
        <i class="fas fa-shield-halved"></i>Services
      </a>

      <div class="nav-section">Website</div>
      <a asp-controller="Home" asp-action="Index" target="_blank">
        <i class="fas fa-globe"></i>View Website
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="admin-info">
        <div class="admin-avatar"><i class="fas fa-user"></i></div>
        <div>
          <div class="admin-name">@Context.Session.GetString("Username")</div>
          <div class="admin-role">Administrator</div>
        </div>
      </div>
      <a asp-controller="Account" asp-action="Logout" class="btn-logout">
        <i class="fas fa-sign-out-alt"></i>Logout
      </a>
    </div>
  </div>

  <!-- MAIN -->
  <div class="main-content">
    <div class="topbar-admin">
      <div>
        <div class="page-title">@ViewData["Title"]</div>
        <div class="breadcrumb-admin">Admin Panel → <span>@ViewData["Title"]</span></div>
      </div>
      <div style="font-size:.82rem; color:#888;">
        <i class="fas fa-clock me-1" style="color:var(--primary)"></i>
        @DateTime.Now.ToString("dddd, dd MMM yyyy")
      </div>
    </div>
    <div class="content-area">
      @RenderBody()
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>