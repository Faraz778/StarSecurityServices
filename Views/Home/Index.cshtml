    <div class="row g-0">
        <div class="col-lg-5 why-img">
            <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=900&q=80" alt="Why Star Security" />
        </div>
        <div class="col-lg-7 d-flex align-items-center">
            <div class="why-content w-100">
                <div class="sec-tag">Why Choose Us</div>
                <h2 class="sec-title sec-title-white">Why <span>Star Security</span><br />Is The Right Choice</h2>
                <div class="title-line mb-4"></div>
                <div class="why-item">
                    <div class="why-icon"><i class="fas fa-shield-halved"></i></div>
                    <div><div class="why-title">Trusted & Certified</div><div class="why-desc">ISO 9001:2000 certified with 24+ years of proven track record in Pakistan's private security industry.</div></div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fas fa-star"></i></div>
                    <div><div class="why-title">Premium Quality Services</div><div class="why-desc">Continuously upgraded training programs ensuring our personnel meet international standards.</div></div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fas fa-microchip"></i></div>
                    <div><div class="why-title">Smart Technology</div><div class="why-desc">State-of-the-art ERP and electronic security systems for complete operational transparency.</div></div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fas fa-headset"></i></div>
                    <div><div class="why-title">24/7 Emergency Support</div><div class="why-desc">Round-the-clock emergency response with dedicated regional teams ready to deploy instantly.</div></div>
                </div>
            </div>
        </div>
    </div>
</section>

