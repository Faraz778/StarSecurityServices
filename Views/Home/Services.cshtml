@{
    ViewData["Title"] = "Services";
}

<!-- ===== SERVICES ===== -->
<section style="background:var(--light);">
    <div class="container">
        <div class="text-center mb-5">
            <div class="sec-tag sec-tag-center">What We Offer</div>
            <h2 class="sec-title">Our <span>Security</span> Services</h2>
            <div class="title-line title-line-center"></div>
            <p class="sec-desc mx-auto" style="max-width:560px;">We cover every dimension of your security requirements — from professional manpower to cutting-edge electronic systems.</p>
        </div>
        <div class="row g-4">

            <div class="col-md-6 col-lg-3">
                <div class="service-card">
                    <div class="svc-num">01</div>
                    <div class="svc-icon"><i class="fas fa-user-shield"></i></div>
                    <div class="svc-title">Manned Guarding</div>
                    <p class="svc-desc">Professional guards, fire squad, dog squad, and bodyguards for industries, banks, retail outlets, hotels, and residential colonies.</p>
                    <a href="#mannedguarding" class="svc-link">Read More <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="service-card">
                    <div class="svc-num">02</div>
                    <div class="svc-icon"><i class="fas fa-money-bill-transfer"></i></div>
                    <div class="svc-title">Cash Services</div>
                    <p class="svc-desc">Secured cash transfer, ATM replenishment, vaulting, processing, multi-point cash collection, and caretaker services.</p>
                    <a href="#cashservices" class="svc-link">Read More <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="service-card">
                    <div class="svc-num">03</div>
                    <div class="svc-icon"><i class="fas fa-camera"></i></div>
                    <div class="svc-title">Electronic Systems</div>
                    <p class="svc-desc">CCTV, access control, fire alarm, intruder alarms, and perimeter protection — complete design, installation, and maintenance.</p>
                    <a href="#electronicsystems" class="svc-link">Read More <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="service-card">
                    <div class="svc-num">04</div>
                    <div class="svc-icon"><i class="fas fa-people-group"></i></div>
                    <div class="svc-title">Recruitment & Training</div>
                    <p class="svc-desc">End-to-end recruitment, training, and deployment of skilled manpower across all security divisions.</p>
                    <a href="#recruitment" class="svc-link">Read More <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ===== MANNED GUARDING DETAIL ===== -->
<section id="mannedguarding" style="background:var(--white);">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&q=80"
                     alt="Manned Guarding" class="img-fluid svc-detail-img" />
            </div>
            <div class="col-lg-6">
                <div class="sec-tag">Service 01</div>
                <h2 class="sec-title">Manned <span>Guarding</span></h2>
                <div class="title-line"></div>
                <p class="sec-desc mb-4">Our manned guarding service provides highly trained security personnel for a wide range of environments. Every guard undergoes rigorous background checks and continuous training to ensure the highest standards of security.</p>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Industrial & Factory Security</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Bank & Financial Institution Guards</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Retail Outlet & Mall Security</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Hotel & Hospitality Security</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Residential Colony Guards</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>VIP Bodyguard Services</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Fire Squad & Dog Squad</span></div>
                <a asp-controller="Home" asp-action="Contact" class="btn-green mt-4 d-inline-block">Get A Quote</a>
            </div>
        </div>
    </div>
</section>

<!-- ===== CASH SERVICES DETAIL ===== -->
<section id="cashservices" style="background:var(--light);">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 order-lg-2">
                <img src="https://images.unsplash.com/photo-1554224155-6726b3ff858f?w=700&q=80"
                     alt="Cash Services" class="img-fluid svc-detail-img" />
            </div>
            <div class="col-lg-6 order-lg-1">
                <div class="sec-tag">Service 02</div>
                <h2 class="sec-title">Cash <span>Services</span></h2>
                <div class="title-line"></div>
                <p class="sec-desc mb-4">Our cash services division provides end-to-end secure cash management solutions for banks, retail chains, and corporate clients — ensuring zero-incident cash handling across Pakistan.</p>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Secured Cash Transfer & Transit</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>ATM Replenishment Services</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Cash Vaulting & Storage</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Cash Processing & Counting</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Multi-Point Cash Collection</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Caretaker Services</span></div>
                <a asp-controller="Home" asp-action="Contact" class="btn-green mt-4 d-inline-block">Get A Quote</a>
            </div>
        </div>
    </div>
</section>

<!-- ===== ELECTRONIC SYSTEMS DETAIL ===== -->
<section id="electronicsystems" style="background:var(--white);">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1557597774-9d273605dfa9?w=700&q=80"
                     alt="Electronic Systems" class="img-fluid svc-detail-img" />
            </div>
            <div class="col-lg-6">
                <div class="sec-tag">Service 03</div>
                <h2 class="sec-title">Electronic <span>Systems</span></h2>
                <div class="title-line"></div>
                <p class="sec-desc mb-4">We design, supply, install, and maintain state-of-the-art electronic security systems tailored to your specific environment — from small offices to large industrial complexes.</p>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>CCTV Surveillance Systems</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Access Control Systems</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Fire Alarm Systems</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Intruder Alarm Systems</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Perimeter Protection</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Annual Maintenance Contracts</span></div>
                <a asp-controller="Home" asp-action="Contact" class="btn-green mt-4 d-inline-block">Get A Quote</a>
            </div>
        </div>
    </div>
</section>

<!-- ===== RECRUITMENT DETAIL ===== -->
<section id="recruitment" style="background:var(--light);">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 order-lg-2">
                <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=700&q=80"
                     alt="Recruitment" class="img-fluid svc-detail-img" />
            </div>
            <div class="col-lg-6 order-lg-1">
                <div class="sec-tag">Service 04</div>
                <h2 class="sec-title">Recruitment <span>& Training</span></h2>
                <div class="title-line"></div>
                <p class="sec-desc mb-4">Our recruitment and training division sources, vets, and trains security professionals to the highest standards — supplying skilled manpower to meet your specific requirements.</p>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Background Verification</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Physical & Medical Fitness Tests</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Security & Combat Training</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>First Aid & Fire Fighting</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Customer Service Training</span></div>
                <div class="svc-feature"><i class="fas fa-check-circle"></i><span>Continuous Development Programs</span></div>
                <a asp-controller="Home" asp-action="Contact" class="btn-green mt-4 d-inline-block">Get A Quote</a>
            </div>
        </div>
    </div>
</section>