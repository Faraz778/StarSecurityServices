@{
    ViewData["Title"] = "About Us";
}

<!-- ===== ABOUT ===== -->
<section style="background:var(--white);">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-5">
                <div class="about-img pe-3">
                    <img src="https://images.unsplash.com/photo-1521737604893-d14cc237f11d?w=700&q=80" alt="About" />
                    <div class="about-badge">
                        <div class="badge-num">24+</div>
                        <div class="badge-lbl">Years of<br />Experience</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="sec-tag">About Us</div>
                <h2 class="sec-title">Your Trusted <span>Security Partner</span><br />Since The Year 2000</h2>
                <div class="title-line"></div>
                <p class="sec-desc mb-3">Founded in 2000, Star Security Services has grown from an investigation firm into Pakistan's leading Total Security Solutions Provider — serving over 250 corporate clients across 24 cities.</p>
                <p class="sec-desc mb-4">With a trained workforce of 2800+ men, supervisors, and 100 senior managers, we deliver unmatched security services with absolute integrity and professionalism.</p>
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="about-counter">
                            <div class="counter-icon"><i class="fas fa-users"></i></div>
                            <div><div class="counter-num">2800+</div><div class="counter-lbl">Trained Personnel</div></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="about-counter">
                            <div class="counter-icon"><i class="fas fa-building"></i></div>
                            <div><div class="counter-num">250+</div><div class="counter-lbl">Corporate Clients</div></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="about-counter">
                            <div class="counter-icon"><i class="fas fa-map-location-dot"></i></div>
                            <div><div class="counter-num">24</div><div class="counter-lbl">Cities Covered</div></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="about-counter">
                            <div class="counter-icon"><i class="fas fa-certificate"></i></div>
                            <div><div class="counter-num">ISO</div><div class="counter-lbl">9001:2000 Certified</div></div>
                        </div>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Contact" class="btn-green">Get Free Quote</a>
            </div>
        </div>
    </div>
</section>

<!-- ===== MISSION VISION ===== -->
<section style="background:var(--light);">
    <div class="container">
        <div class="text-center mb-5">
            <div class="sec-tag sec-tag-center">Who We Are</div>
            <h2 class="sec-title">Our <span>Mission</span> & Vision</h2>
            <div class="title-line title-line-center"></div>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="mv-card">
                    <div class="mv-icon"><i class="fas fa-bullseye"></i></div>
                    <div class="mv-title">Our Mission</div>
                    <p class="mv-desc">To provide world-class security services with trained, disciplined, and professional personnel — ensuring complete safety and peace of mind for all our clients across Pakistan.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mv-card">
                    <div class="mv-icon"><i class="fas fa-eye"></i></div>
                    <div class="mv-title">Our Vision</div>
                    <p class="mv-desc">To be recognized as Pakistan's most trusted and innovative total security solutions provider — setting industry benchmarks in quality, integrity, and technology-driven security.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="mv-card">
                    <div class="mv-icon"><i class="fas fa-handshake"></i></div>
                    <div class="mv-title">Our Values</div>
                    <p class="mv-desc">Integrity, professionalism, and continuous improvement are the core values that guide every decision we make — from hiring our guards to serving our clients.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== WHY CHOOSE US ===== -->
<section style="background:var(--dark); padding:0;">
    <div class="row g-0">
        <div class="col-lg-5 why-img">
            <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?w=900&q=80" alt="Why Star Security" />
        </div>
        <div class="col-lg-7 d-flex align-items-center">
            <div class="why-content w-100">
                <div class="sec-tag">Why Choose Us</div>
                <h2 class="sec-title sec-title-white">Why <span>Star Security</span><br />Is The Right Choice</h2>
                <div class="title-line mb-4"></div>
                <div class="why-item">
                    <div class="why-icon"><i class="fas fa-shield-halved"></i></div>
                    <div><div class="why-title">Trusted & Certified</div><div class="why-desc">ISO 9001:2000 certified with 24+ years of proven track record in Pakistan's private security industry.</div></div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fas fa-star"></i></div>
                    <div><div class="why-title">Premium Quality Services</div><div class="why-desc">Continuously upgraded training programs ensuring our personnel meet international security standards.</div></div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fas fa-microchip"></i></div>
                    <div><div class="why-title">Smart Technology</div><div class="why-desc">State-of-the-art ERP and electronic security systems for complete operational transparency.</div></div>
                </div>
                <div class="why-item">
                    <div class="why-icon"><i class="fas fa-headset"></i></div>
                    <div><div class="why-title">24/7 Emergency Support</div><div class="why-desc">Round-the-clock emergency response with dedicated regional teams ready to deploy instantly.</div></div>
                </div>
            </div>
        </div>
    </div>
</section>

