@model List<StarSecurityServices.Models.Vacancy>
@{
    ViewData["Title"] = "Careers";
}

<!-- ===== CAREERS HERO ===== -->
<section style="background:var(--dark); padding:60px 0;">
    <div class="container text-center">
        <div class="sec-tag sec-tag-center">Join Our Team</div>
        <h2 class="sec-title sec-title-white">Build Your <span>Career</span> With Us</h2>
        <div class="title-line title-line-center"></div>
        <p class="sec-desc sec-desc-white mx-auto" style="max-width:550px;">
            We are always looking for dedicated professionals who share our
            commitment to excellence, integrity, and professionalism.
        </p>
    </div>
</section>

<!-- ===== WHY JOIN US ===== -->
<section style="background:var(--light);">
    <div class="container">
        <div class="text-center mb-5">
            <div class="sec-tag sec-tag-center">Why Us</div>
            <h2 class="sec-title">Why Join <span>Star Security</span></h2>
            <div class="title-line title-line-center"></div>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="join-card">
                    <div class="join-icon"><i class="fas fa-graduation-cap"></i></div>
                    <div class="join-title">Training & Growth</div>
                    <p class="join-desc">Continuous training programs to develop your skills and advance your career.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="join-card">
                    <div class="join-icon"><i class="fas fa-money-bill-wave"></i></div>
                    <div class="join-title">Competitive Salary</div>
                    <p class="join-desc">Market-competitive salaries with performance bonuses and annual increments.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="join-card">
                    <div class="join-icon"><i class="fas fa-heart-pulse"></i></div>
                    <div class="join-title">Health Benefits</div>
                    <p class="join-desc">Comprehensive medical coverage for you and your family.</p>
                </div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="join-card">
                    <div class="join-icon"><i class="fas fa-award"></i></div>
                    <div class="join-title">Recognition</div>
                    <p class="join-desc">Monthly and annual employee recognition programs for outstanding performance.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ===== VACANCIES (Database se) ===== -->
<section style="background:var(--white);">
    <div class="container">
        <div class="text-center mb-5">
            <div class="sec-tag sec-tag-center">Open Positions</div>
            <h2 class="sec-title">Current <span>Vacancies</span></h2>
            <div class="title-line title-line-center"></div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="fas fa-briefcase fa-3x mb-3" style="color:#ddd;"></i>
                <h5 style="color:#888;">No vacancies available at the moment.</h5>
                <p style="color:#aaa; font-size:.88rem;">
                    Please check back later or send your CV to hr@starsecurity.pk
                </p>
            </div>
        }
        else
        {
            @foreach (var vacancy in Model)
            {
                <div class="vacancy-item">
                    <div>
                        <div class="vac-title">@vacancy.Title</div>
                        <div class="vac-tags">
                            <span class="vac-tag">
                                <i class="fas fa-map-marker-alt"></i>@vacancy.City
                            </span>
                            <span class="vac-tag">
                                <i class="fas fa-briefcase"></i>@vacancy.JobType
                            </span>
                            <span class="vac-tag">
                                <i class="fas fa-building"></i>@vacancy.Department
                            </span>
                            <span class="vac-tag">
                                <i class="fas fa-calendar"></i>@vacancy.PostedDate.ToString()
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(vacancy.Description))
                        {
                            <div style="font-size:.82rem; color:#888; margin-top:8px;">
                                @vacancy.Description
                            </div>
                        }
                    </div>
                    <a href="#applyform" class="btn-apply">Apply Now</a>
                </div>
            }
        }

    </div>
</section>

<!-- ===== APPLY FORM ===== -->
<section id="applyform" style="background:var(--light);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="apply-form-wrap">
                    <div class="text-center mb-4">
                        <div class="sec-tag sec-tag-center">Apply Now</div>
                        <h2 class="sec-title">Submit Your <span>Application</span></h2>
                        <div class="title-line title-line-center"></div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="apply-lbl">Full Name *</label>
                            <input type="text" class="apply-ctrl" placeholder="Muhammad Ali" />
                        </div>
                        <div class="col-md-6">
                            <label class="apply-lbl">Email Address *</label>
                            <input type="email" class="apply-ctrl" placeholder="you@email.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="apply-lbl">Phone Number *</label>
                            <input type="text" class="apply-ctrl" placeholder="+92 300 0000000" />
                        </div>
                        <div class="col-md-6">
                            <label class="apply-lbl">City *</label>
                            <input type="text" class="apply-ctrl" placeholder="Karachi" />
                        </div>
                        <div class="col-12">
                            <label class="apply-lbl">Position Applying For *</label>
                            <select class="apply-ctrl">
                                <option value="" disabled selected>-- Select Position --</option>
                                @foreach (var vacancy in Model)
                                {
                                    <option>@vacancy.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="apply-lbl">Qualification</label>
                            <input type="text" class="apply-ctrl"
                                   placeholder="e.g. Intermediate, Bachelor" />
                        </div>
                        <div class="col-12">
                            <label class="apply-lbl">Experience</label>
                            <textarea class="apply-ctrl" rows="4"
                                      placeholder="Briefly describe your relevant experience..."></textarea>
                        </div>
                        <div class="col-12 mt-2">
                            <button class="btn-green w-100"
                                    style="padding:14px; font-size:.88rem; cursor:pointer;">
                                <i class="fas fa-paper-plane me-2"></i>Submit Application
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>