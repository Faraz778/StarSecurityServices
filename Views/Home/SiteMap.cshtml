@{
    ViewData["Title"] = "Site Map";
}

<!-- ===== HERO ===== -->
<section style="background:var(--dark); padding:60px 0;">
    <div class="container text-center">
        <div class="sec-tag sec-tag-center">Navigation</div>
        <h2 class="sec-title sec-title-white">Site <span>Map</span></h2>
        <div class="title-line title-line-center"></div>
        <p class="sec-desc sec-desc-white mx-auto" style="max-width:500px;">
            Complete overview of all pages and sections available on
            Star Security Services website.
        </p>
    </div>
</section>

<!-- ===== SITEMAP CONTENT ===== -->
<section style="background:var(--light);">
    <div class="container">
        <div class="row g-4">

            <!-- PUBLIC WEBSITE -->
            <div class="col-md-6 col-lg-4">
                <div class="sitemap-card">
                    <div class="sitemap-card-header">
                        <i class="fas fa-globe"></i> Public Website
                    </div>
                    <ul class="sitemap-list">
                        <li>
                            <a asp-controller="Home" asp-action="Index">
                                <i class="fas fa-angle-right"></i> Home
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="About">
                                <i class="fas fa-angle-right"></i> About Us
                            </a>
                            <ul class="sitemap-sublist">
                                <li><i class="fas fa-minus"></i> Company History</li>
                                <li><i class="fas fa-minus"></i> Chairman's Profile</li>
                                <li><i class="fas fa-minus"></i> Board of Directors</li>
                                <li><i class="fas fa-minus"></i> Our Team</li>
                            </ul>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Services">
                                <i class="fas fa-angle-right"></i> Our Business
                            </a>
                            <ul class="sitemap-sublist">
                                <li><i class="fas fa-minus"></i> Manned Guarding</li>
                                <li><i class="fas fa-minus"></i> Cash Services</li>
                                <li><i class="fas fa-minus"></i> Electronic Systems</li>
                                <li><i class="fas fa-minus"></i> Recruitment & Training</li>
                            </ul>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Network">
                                <i class="fas fa-angle-right"></i> Our Network
                            </a>
                            <ul class="sitemap-sublist">
                                <li><i class="fas fa-minus"></i> North Region</li>
                                <li><i class="fas fa-minus"></i> West Region</li>
                                <li><i class="fas fa-minus"></i> East Region</li>
                                <li><i class="fas fa-minus"></i> South Region</li>
                            </ul>
                        </li>
                        <li>
                            <a asp-controller="Home" asp-action="Careers">
                                <i class="fas fa-angle-right"></i> Careers
                            </a>
                            <ul class="sitemap-sublist">
