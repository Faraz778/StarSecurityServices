@{
    ViewData["Title"] = "Our Network";
}

<!-- ===== NETWORK HERO ===== -->
<section style="background:var(--dark); padding:60px 0;">
    <div class="container text-center">
        <div class="sec-tag sec-tag-center" style="color:var(--primary);">Our Reach</div>
        <h2 class="sec-title sec-title-white">Nationwide <span>Network</span></h2>
        <div class="title-line title-line-center"></div>
        <p class="sec-desc sec-desc-white mx-auto" style="max-width:550px;">
            Strategically positioned across all four regions of Pakistan to ensure rapid response and local security expertise.
        </p>
    </div>
</section>

<!-- ===== STATS BAR ===== -->
<div style="background:var(--primary); padding:28px 0;">
    <div class="container">
        <div class="row g-0 text-center">
            <div class="col-6 col-md-3" style="border-right:1px solid rgba(0,0,0,.1);">
                <div class="nw-stat-num">4</div>
                <div class="nw-stat-lbl">Regions</div>
            </div>
            <div class="col-6 col-md-3" style="border-right:1px solid rgba(0,0,0,.1);">
                <div class="nw-stat-num">24</div>
                <div class="nw-stat-lbl">Cities</div>
            </div>
            <div class="col-6 col-md-3" style="border-right:1px solid rgba(0,0,0,.1);">
                <div class="nw-stat-num">250+</div>
                <div class="nw-stat-lbl">Clients</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="nw-stat-num">2800+</div>
                <div class="nw-stat-lbl">Personnel</div>
            </div>
        </div>
    </div>
</div>

<!-- ===== REGION CARDS ===== -->
<section style="background:var(--white);">
    <div class="container">
        <div class="text-center mb-5">
            <div class="sec-tag sec-tag-center">Our Offices</div>
            <h2 class="sec-title">Regional <span>Offices</span></h2>
            <div class="title-line title-line-center"></div>
        </div>
        <div class="row g-4">

            <!-- NORTH -->
            <div class="col-md-6 col-lg-3">
                <div class="region-card">
                    <div class="region-num">01</div>
                    <div class="region-icon"><i class="fas fa-location-dot"></i></div>
                    <div class="region-title">North Region</div>
                    <div class="region-line"><i class="fas fa-city"></i>Islamabad, Rawalpindi, Peshawar</div>
                    <div class="region-line"><i class="fas fa-phone"></i>+92-51-000-0001</div>
                    <div class="region-line"><i class="fas fa-envelope"></i>north@starsecurity.pk</div>
                    <div class="region-line"><i class="fas fa-user"></i>Mr. Ahmed Ali</div>
                    <div class="region-line"><i class="fas fa-map-marker-alt"></i>Office 5, Blue Area, Islamabad</div>
                </div>
            </div>

            <!-- WEST -->
