                    <div class="region-line"><i class="fas fa-envelope"></i>west@starsecurity.pk</div>
                    <div class="region-line"><i class="fas fa-user"></i>Mr. Babar Khan</div>
                    <div class="region-line"><i class="fas fa-map-marker-alt"></i>Office 2, Jinnah Road, Quetta</div>
