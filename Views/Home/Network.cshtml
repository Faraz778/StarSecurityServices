                    <div class="region-line"><i class="fas fa-city"></i>Lahore, Faisalabad, Multan</div>
                    <div class="region-line"><i class="fas fa-phone"></i>+92-42-000-0003</div>
                    <div class="region-line"><i class="fas fa-envelope"></i>east@starsecurity.pk</div>
