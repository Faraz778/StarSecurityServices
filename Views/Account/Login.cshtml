@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login — Star Security Services</title>
    <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
            :root { --primary:#84C729; --dark:#091E3E; }
            * { margin:0; padding:0; box-sizing:border-box; }
            body {
              font-family:'Heebo',sans-serif;
              background: linear-gradient(135deg, #091E3E 0%, #1a3a6e 100%);
              min-height:100vh; display:flex; align-items:center; justify-content:center;
            }
            .login-wrap {
              width:100%; max-width:440px; padding:20px;
            }
            .login-card {
              background:#fff; border-radius:4px;
              padding:44px 40px;
              box-shadow:0 20px 60px rgba(0,0,0,.3);
            }
            .login-logo {
              text-align:center; margin-bottom:30px;
            }
            .logo-hex {
              width:56px; height:56px; background:var(--primary);
              clip-path:polygon(50% 0%,100% 25%,100% 75%,50% 100%,0% 75%,0% 25%);
              display:flex; align-items:center; justify-content:center;
              margin:0 auto 12px;
            }
            .logo-hex i { color:#fff; font-size:1.3rem; }
            .login-brand {
              font-size:1.3rem; font-weight:800; color:var(--dark);
            }
            .login-brand span { color:var(--primary); }
            .login-sub {
              font-size:.75rem; color:#888; letter-spacing:2px;
              text-transform:uppercase; margin-top:4px;
            }
            .login-title {
              font-size:1.4rem; font-weight:800; color:var(--dark);
              margin-bottom:6px;
            }
            .login-desc { font-size:.83rem; color:#888; margin-bottom:28px; }
            .form-lbl {
              font-size:.74rem; font-weight:600; letter-spacing:.5px;
              text-transform:uppercase; color:#666; margin-bottom:6px; display:block;
            }
            .form-ctrl {
              width:100%; border:1.5px solid #e2e8f0;
              border-radius:3px; padding:11px 14px;
              font-size:.9rem; font-family:'Heebo',sans-serif;
              color:var(--dark); outline:none; transition:border-color .2s;
              margin-bottom:18px;
            }
            .form-ctrl:focus { border-color:var(--primary); }
            .input-icon-wrap { position:relative; }
            .input-icon-wrap i {
              position:absolute; right:14px; top:50%;
              transform:translateY(-50%); color:#aaa; font-size:.9rem;
            }
            .btn-login-submit {
              width:100%; background:var(--primary); color:#fff;
              font-size:.88rem; font-weight:700; letter-spacing:1px;
              text-transform:uppercase; padding:13px;
              border:none; border-radius:30px; cursor:pointer;
              font-family:'Heebo',sans-serif; transition:background .2s, transform .2s;
              margin-top:6px;
            }
            .btn-login-submit:hover { background:#70ad1f; transform:translateY(-1px); }
            .error-msg {
              background:#fff5f5; border:1px solid #fed7d7;
              color:#c53030; font-size:.83rem; padding:10px 14px;
              border-radius:3px; margin-bottom:18px;
              display:flex; align-items:center; gap:8px;
            }
            .back-link {
              text-align:center; margin-top:20px;
              font-size:.82rem; color:#888;
            }
            .back-link a { color:var(--primary); text-decoration:none; font-weight:600; }
            .back-link a:hover { text-decoration:underline; }
            .divider {
              border:none; border-top:1px solid #f0f0f0; margin:20px 0;
            }
            .demo-creds {
              background:#f8fff0; border:1px solid #d4edda;
              border-radius:3px; padding:12px 16px; font-size:.78rem; color:#555;
            }
            .demo-creds strong { color:var(--primary); }
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="login-card">

            <!-- LOGO -->
            <div class="login-logo">
                <div class="logo-hex"><i class="fas fa-shield-alt"></i></div>
                <div class="login-brand">Star <span>Security</span></div>
                <div class="login-sub">Employee Portal</div>
            </div>

            <div class="login-title">Welcome Back</div>
            <div class="login-desc">Sign in to access your dashboard</div>

            <!-- ERROR -->
            @if (ViewBag.Error != null)
            {
                <div class="error-msg">
                    <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
                </div>
            }

            <!-- FORM -->
            <form method="post" asp-action="Login" asp-controller="Account">
                <label class="form-lbl">Username</label>
                <div class="input-icon-wrap">
                    <input type="text" name="username" class="form-ctrl" placeholder="Enter your username" />
                    <i class="fas fa-user"></i>
                </div>

                <label class="form-lbl">Password</label>
                <div class="input-icon-wrap">
                    <input type="password" name="password" class="form-ctrl" placeholder="Enter your password" />
                    <i class="fas fa-lock"></i>
                </div>

                <button type="submit" class="btn-login-submit">
                    <i class="fas fa-sign-in-alt me-2"></i>Sign In
                </button>
            </form>

            <hr class="divider" />

            <!-- DEMO CREDENTIALS -->
            <div class="demo-creds">
                <i class="fas fa-info-circle" style="color:var(--primary)"></i>
                <strong>Demo:</strong> Username: <strong>admin</strong> | Password: <strong>Admin@123</strong>
            </div>

            <div class="back-link">
                <a asp-controller="Home" asp-action="Index">
                    <i class="fas fa-arrow-left me-1"></i>Back to Website
                </a>
            </div>

        </div>
    </div>
</body>
</html>