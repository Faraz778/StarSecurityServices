@model List<StarSecurityServices.Models.Client>
@{
    ViewData["Title"] = "Clients";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0" style="color:var(--dark);">
        <i class="fas fa-building me-2" style="color:var(--primary)"></i>All Clients
    </h5>
    <a asp-controller="Admin" asp-action="AddClient" class="btn-primary-admin">
        <i class="fas fa-plus me-2"></i>Add Client
    </a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Client Name</th>
                <th>Services Availed</th>
                <th>Staff Assigned</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="5" class="text-center py-4" style="color:#888;">
                        <i class="fas fa-building fa-2x mb-2 d-block" style="color:#ddd;"></i>
                        No clients found. Add your first client.
                    </td>
                </tr>
            }
            @foreach (var client in Model)
            {
                <tr>
                    <td>@client.Id</td>
                    <td><strong>@client.ClientName</strong></td>
                    <td>@client.ServicesAvailed</td>
                    <td>
                        <span class="badge-active">@client.StaffAssigned Guards</span>
                    </td>
                    <td>
                        <a asp-controller="Admin" asp-action="EditClient"
                               asp-route-id="@client.Id" class="btn-edit me-1">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-controller="Admin" asp-action="DeleteClient"
                               asp-route-id="@client.Id" class="btn-delete"
                               onclick="return confirm('Are you sure you want to delete this client?')">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>