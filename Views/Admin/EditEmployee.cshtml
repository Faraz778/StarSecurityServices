@model StarSecurityServices.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0" style="color:var(--dark);">
        <i class="fas fa-user-edit me-2" style="color:var(--primary)"></i>Edit Employee
    </h5>
    <a asp-controller="Admin" asp-action="Employees" class="btn-back">
        <i class="fas fa-arrow-left me-2"></i>Back
    </a>
</div>

<div class="form-card">
    <form method="post" asp-action="EditEmployee" asp-controller="Admin">

        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Employee Code *</label>
                <input type="text" name="EmployeeCode" class="form-control"
                       value="@Model.EmployeeCode" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Full Name *</label>
                <input type="text" name="FullName" class="form-control"
                       value="@Model.FullName" required />
            </div>

            <div class="col-md-6">
                <label class="form-label">Department *</label>
                <select name="Department" class="form-select" required>
                    <option value="" disabled>-- Select Department --</option>
                    @foreach (var dept in new[] { "Manned Guarding", "Cash Services",
                        "Electronic Systems", "Recruitment & Training",
                        "HR Division", "Administration" })
                    {
                        <option value="@dept" selected="@(Model.Department == dept)">
                            @dept
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Grade</label>
                <select name="Grade" class="form-select">
                    @foreach (var grade in new[] { "Grade A", "Grade B", "Grade C",
                        "Supervisor", "Manager", "Senior Manager" })
                    {
                        <option value="@grade" selected="@(Model.Grade == grade)">
                            @grade
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label">Contact Number</label>
                <input type="text" name="ContactNumber" class="form-control"
                       value="@Model.ContactNumber" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Qualification</label>
                <input type="text" name="Qualification" class="form-control"
                       value="@Model.Qualification" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Joining Date</label>
                <input type="date" name="JoiningDate" class="form-control"
                       value="@Model.JoiningDate?.ToString("yyyy-MM-dd")" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Assigned Client</label>
                <select name="ClientId" class="form-select">
                    <option value="">-- No Client --</option>
                    @foreach (var client in ViewBag.Clients)
                    {
                        <option value="@client.Id"
                                selected="@(Model.ClientId == client.Id)">
                            @client.ClientName
                        </option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="form-label">Address</label>
                <input type="text" name="Address" class="form-control"
                       value="@Model.Address" />
            </div>

            <div class="col-12">
                <label class="form-label">Achievements</label>
                <textarea name="Achievements" class="form-control" rows="3">@Model.Achievements</textarea>
            </div>

            <div class="col-12 mt-2">
                <button type="submit" class="btn-primary-admin">
                    <i class="fas fa-save me-2"></i>Update Employee
                </button>
                <a asp-controller="Admin" asp-action="Employees"
                   class="btn-back ms-2">Cancel</a>
            </div>

        </div>
    </form>
</div>