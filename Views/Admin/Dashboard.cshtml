@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- STAT CARDS -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-users"></i></div>
            <div>
                <div class="stat-num">@ViewBag.TotalEmployees</div>
                <div class="stat-lbl">Total Employees</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-building"></i></div>
            <div>
                <div class="stat-num">@ViewBag.TotalClients</div>
                <div class="stat-lbl">Total Clients</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-briefcase"></i></div>
            <div>
                <div class="stat-num">@ViewBag.TotalVacancies</div>
                <div class="stat-lbl">Open Vacancies</div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-icon"><i class="fas fa-shield-halved"></i></div>
            <div>
                <div class="stat-num">@ViewBag.TotalServices</div>
                <div class="stat-lbl">Total Services</div>
            </div>
        </div>
    </div>
</div>

<!-- QUICK LINKS -->
<div class="row g-4">
    <div class="col-12">
        <div class="form-card">
            <h6 class="fw-700 mb-3" style="color:var(--dark); font-weight:700;">
                <i class="fas fa-bolt me-2" style="color:var(--primary)"></i>Quick Actions
            </h6>
            <div class="d-flex gap-3 flex-wrap">
                <a asp-controller="Admin" asp-action="AddEmployee" class="btn-primary-admin">
                    <i class="fas fa-user-plus me-2"></i>Add Employee
                </a>
                <a asp-controller="Admin" asp-action="AddClient" class="btn-primary-admin">
                    <i class="fas fa-building me-2"></i>Add Client
                </a>
                <a asp-controller="Admin" asp-action="AddVacancy" class="btn-primary-admin">
                    <i class="fas fa-plus me-2"></i>Add Vacancy
                </a>
                <a asp-controller="Admin" asp-action="AddService" class="btn-primary-admin">
                    <i class="fas fa-shield-halved me-2"></i>Add Service
                </a>
            </div>
        </div>
    </div>
</div>