@model List<StarSecurityServices.Models.Employee>
@{
    ViewData["Title"] = "Employees";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0" style="color:var(--dark);">
        <i class="fas fa-users me-2" style="color:var(--primary)"></i>All Employees
    </h5>
    <a asp-controller="Admin" asp-action="AddEmployee" class="btn-primary-admin">
        <i class="fas fa-user-plus me-2"></i>Add Employee
    </a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Code</th>
                <th>Name</th>
                <th>Department</th>
                <th>Grade</th>
                <th>Contact</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center py-4" style="color:#888;">
                        <i class="fas fa-users fa-2x mb-2 d-block" style="color:#ddd;"></i>
                        No employees found. Add your first employee.
                    </td>
                </tr>
            }
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.Id</td>
                    <td><strong style="color:var(--primary)">@emp.EmployeeCode</strong></td>
                    <td>@emp.FullName</td>
                    <td>@emp.Department</td>
                    <td>@emp.Grade</td>
                    <td>@emp.ContactNumber</td>
                    <td>
                        <a asp-controller="Admin" asp-action="EditEmployee"
                               asp-route-id="@emp.Id" class="btn-edit me-1">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-controller="Admin" asp-action="DeleteEmployee"
                               asp-route-id="@emp.Id" class="btn-delete"
                               onclick="return confirm('Are you sure you want to delete this employee?')">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>