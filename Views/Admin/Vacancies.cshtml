@model List<StarSecurityServices.Models.Vacancy>
@{
    ViewData["Title"] = "Vacancies";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-bold mb-0" style="color:var(--dark);">
        <i class="fas fa-briefcase me-2" style="color:var(--primary)"></i>All Vacancies
    </h5>
    <a asp-controller="Admin" asp-action="AddVacancy" class="btn-primary-admin">
        <i class="fas fa-plus me-2"></i>Add Vacancy
    </a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Title</th>
                <th>Department</th>
                <th>City</th>
                <th>Job Type</th>
                <th>Posted Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center py-4" style="color:#888;">
                        <i class="fas fa-briefcase fa-2x mb-2 d-block" style="color:#ddd;"></i>
                        No vacancies found. Add your first vacancy.
                    </td>
                </tr>
            }
            @foreach (var vacancy in Model)
            {
                <tr>
                    <td>@vacancy.Id</td>
                    <td><strong>@vacancy.Title</strong></td>
                    <td>@vacancy.Department</td>
                    <td>@vacancy.City</td>
                    <td>@vacancy.JobType</td>
                    <td>@vacancy.PostedDate.ToString()</td>
                    <td>
                        @if (vacancy.IsFilled == true)
                        {
                            <span class="badge-inactive">Filled</span>
                        }
                        else
                        {
                            <span class="badge-active">Open</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Admin" asp-action="EditVacancy"
                               asp-route-id="@vacancy.Id" class="btn-edit me-1">
                            <i class="fas fa-edit"></i> Edit
                        </a>
                        <a asp-controller="Admin" asp-action="DeleteVacancy"
                               asp-route-id="@vacancy.Id" class="btn-delete"
                               onclick="return confirm('Delete this vacancy?')">
                            <i class="fas fa-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>